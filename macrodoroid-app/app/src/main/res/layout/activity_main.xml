<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Macrodoroid"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1D1D1F"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LINE通知 → SMS転送"
        android:textSize="14sp"
        android:textColor="#6E6E73"
        android:layout_marginBottom="32dp" />

    <!-- 通知アクセス設定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="① 通知アクセスを許可"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1D1D1F"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="設定画面でMacrodoroidの通知アクセスをオンにしてください"
            android:textSize="13sp"
            android:textColor="#6E6E73"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知アクセス設定を開く" />

    </LinearLayout>

    <!-- 転送先追加 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="② 転送先を追加"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1D1D1F"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="例: 09012345678"
                android:inputType="phone"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAddNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="追加" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登録済みの番号："
            android:textSize="13sp"
            android:textColor="#6E6E73"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/llPhoneList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- 有効/無効 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="③ 転送を有効にする"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1D1D1F" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>
