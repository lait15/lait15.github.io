# ============================
# ミニOpenClaw 設定ファイル
# ============================
# このファイルを .env にコピーして、各値を設定してください
# cp .env.example .env

# ----------------------------
# AIモデル設定
# ----------------------------
# プロバイダー選択: "google" / "openai" / "anthropic"
MODEL_PROVIDER=google

# モデル名
# Google:    gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# OpenAI:    gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Anthropic: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-6
MODEL_NAME=gemini-1.5-flash

# ----------------------------
# APIキー（使うプロバイダーのものを設定）
# ----------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ----------------------------
# Discord設定
# ----------------------------
# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Botを許可するDiscordサーバーID（カンマ区切り、空欄=全サーバー許可）
ALLOWED_GUILD_IDS=

# ----------------------------
# セキュリティ設定
# ----------------------------
# 実行を許可するコマンド（カンマ区切り）
ALLOWED_COMMANDS=ls,pwd,echo,date,cat,curl,python3,node

# ファイル操作を許可するディレクトリ（絶対パスまたは相対パス）
WORKSPACE_DIR=./workspace
